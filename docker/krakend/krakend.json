      "@comment": "Event API",
      "endpoint": "/api/v1/events",
      "method": "POST",
      "input_headers": ["*"],
      "input_query_strings": ["*"],
      "backend": [
        {
          "host": ["http://event-service:8001"],
          "url_pattern": "/api/v1/events",
          "encoding": "no-op"
        }
      ]
    },
    {
