{
  "version": 3,
  "name": "TeamFlow API Gateway",
  "timeout": "30s",
  "port": 8080,
  "extra_config": {
    "telemetry/logging": {
      "level": "INFO",
      "prefix": "[KRAKEND]",
      "syslog": false,
      "stdout": true
    }
  },
