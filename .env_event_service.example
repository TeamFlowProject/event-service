# Event Service — copy to .env_event_service and adjust if needed
# cp .env_event_service.example .env_event_service

EVENT_SERVICE_PORT=8001

DATABASE_DSN=postgresql://user:password@postgres:5432/event_db
DATABASE_MIN_CONNECTIONS=1
DATABASE_MAX_CONNECTIONS=10

KAFKA_BOOTSTRAP=redpanda:9092
KAFKA_TOPIC_COMMANDS=event-commands
KAFKA_TOPIC_EVENTS=event-events
KAFKA_GROUP_ID=event-service

HTTP_HOST=0.0.0.0
HTTP_PORT=8001

LOG_LEVEL=INFO
LOG_JSON=true

OTEL_SERVICE_NAME=event-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_ENABLED=true
