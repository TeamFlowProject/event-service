# --- HTTP ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8001

# --- Database (Postgres) ---
DATABASE_DSN=postgresql://user:password@localhost:5432/event_db
DATABASE_MIN_CONNECTIONS=1
DATABASE_MAX_CONNECTIONS=10

# --- Kafka ---
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC_COMMANDS=event-commands
KAFKA_TOPIC_EVENTS=event-events
KAFKA_GROUP_ID=event-service

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- OpenTelemetry ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=event-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
